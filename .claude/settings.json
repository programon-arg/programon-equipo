{
  "extraKnownMarketplaces": {
    "programon": {
      "source": {
        "source": "github",
        "repo": "programon-arg/programon-equipo"
      }
    }
  },
  "enabledPlugins": {
    "pm@programon": true
  },
  "permissions": {
