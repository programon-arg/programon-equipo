# El banco de trabajo es local: nada de lo que cae adentro se versiona ni se pushea.
# Ver Proyectos/README.md para la regla.
Proyectos/*
!Proyectos/README.md

# Las adaptaciones de cada persona son suyas y locales. Así una actualización del
# plugin nunca las pisa ni choca con ellas. Ver la skill `ajustar`.
.claude/skills/
.claude/agents/
.claude/settings.local.json

# Quién es la persona: lo escribe el onboarding, se carga en todas sus sesiones,
# y no viaja a nadie.
CLAUDE.local.md

.DS_Store
